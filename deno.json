{
  "entrypoint": "main.ts",
  "tasks": {
    "start": "deno serve --unstable-kv --unstable-cron -A main.ts",
    "dev": "deno run --watch --unstable-kv --unstable-cron -A main.ts",
    "build": "echo 'Skipping Fresh build - standalone Hono entrypoint'"
  },
  "unstable": [
    "kv",
    "cron"
  ],
  "imports": {
    "hono": "npm:hono@4.6.14",
    "hono/cors": "npm:hono@4.6.14/cors",
    "hono/body-limit": "npm:hono@4.6.14/body-limit"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"]
  }
}
